@'
# Entornos virtuales
env/
venv/
.env

# Configuración de editor
.vscode/

# Herramientas de IA y reglas locales
.claude/
.clinerules

# Archivos temporales de Python
*.pyc
__pycache__/

# Base de datos local
*.sqlite3

# Archivos multimedia de prueba
media/

# Sistema operativo
Thumbs.db
.DS_Store
'@ | Out-File -FilePath .gitignore -Encoding utf8